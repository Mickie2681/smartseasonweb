{
  "rootDirectory": "frontend",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_URL": "@vite_api_url"
  },
  "rewrites": [
    {
      "source": "/:path((?!.*\\..*|_next).*)",
      "destination": "/index.html"
    }
  ]
}
